<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cadetBlue"
    android:gravity="center_horizontal"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/keyValText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/antiqeWhite"
        android:text="Podaj wartość klucza" />

    <EditText
        android:id="@+id/keyVal"
        android:layout_width="match_parent"
        android:background="@color/white"
        android:layout_marginLeft="150dp"
        android:layout_marginRight="150dp"
        android:inputType="number"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/textValText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/antiqeWhite"
        android:text="Podaj tekst" />

    <EditText
        android:id="@+id/textVal"
        android:layout_width="match_parent"
        android:layout_margin="20dp"
        android:background="@color/white"
        android:ems="10"
        android:gravity="start|top"
        android:inputType="textMultiLine"
        android:layout_height="wrap_content" />

    <Button
        android:id="@+id/btnCypher"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/lighBlue"
        android:text="Zaszyfruj" />

    <TextView
        android:id="@+id/textCypheredText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/antiqeWhite"
        android:text="Tekst zaszyfrowany" />

    <TextView
        android:id="@+id/textCyphered"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/border"
        android:textColor="@color/aliceBlue"
        android:layout_margin="20dp" />

    <Button
        android:id="@+id/btnCypherToFile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/lighBlue"
        android:text="Zapisz szyfr w pliku" />

</LinearLayout>